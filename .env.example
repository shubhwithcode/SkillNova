# ======================================================
# SkillNova environment configuration (EXAMPLE FILE)
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to Git.
# ======================================================

# ---- Server (Phase 1) ----
PORT=3000

# ---- MySQL Database (used from Phase 2) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=skillnova

# ---- Session security (used from Phase 2) ----
SESSION_SECRET=replace_with_a_long_random_string

# ---- AI provider ----
# Google Gemini API key - https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ---- Python (resume PDF extraction) ----
# Command used to run Python (change to "py" or a full path if needed)
PYTHON_COMMAND=python
